# Feature flags: on or off. Vite reads these at build time, so changing one
# means rebuilding (on Vercel, set them per environment and redeploy). Copy to
# .env.local to change them locally, or set one for a single run:
#
#   VITE_FLAG_ANALYTICS=off npm run dev
#
# src/flags.js lists every flag and its default. deploy.sh forces some of them
# for the live site whatever these files say (its FLAGS list).

# Google Analytics and its cookie banner (production builds only)
VITE_FLAG_ANALYTICS=on
# Send analytics from dev too, and mark every hit debug_mode for DebugView
VITE_FLAG_GA_DEBUG=off
